<?xml version="1.0" encoding="utf-8"?>
<GameDB>
	<Table name="server" desc="서버 목록">
    <Column name="name" type="nvarchar(50)" notnull="true" />
		<Column name="ip" type="nvarchar(50)" notnull="false" />
		<Column name="port" type="int" notnull="false" />
		<Index type="clustered">
			<PrimaryKey/>
			<Column name="name" />
		</Index>
	</Table>

	<Procedure name="spGetServerList">
		<Body>
			<![CDATA[
			SELECT name, ip, port FROM server;
			]]>
		</Body>
	</Procedure>
	
</GameDB>